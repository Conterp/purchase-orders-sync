# Bimer / Alterdata
BIMER_BASE_URL=https://740316bimerapi.alterdata.cloud
BIMER_USERNAME=
BIMER_PASSWORD=
BIMER_COMPANY_CODE=01
BIMER_TOKEN_TTL_MINUTES=50

# Monday
MONDAY_API_TOKEN=
MONDAY_API_URL=https://api.monday.com/v2
MONDAY_API_VERSION=2025-10
MONDAY_BOARD_ID=18436055602
MONDAY_BOARD_NAME=Conterp - Pedidos de Compra
MONDAY_PAGE_SIZE=500

# n8n
N8N_SUMMARY_WEBHOOK_URL=

# Retry / timeout
HTTP_MAX_RETRIES=5
HTTP_BACKOFF_BASE=1.0
HTTP_BACKOFF_FACTOR=2.0
HTTP_BACKOFF_CAP=60.0
HTTP_JITTER_MIN=0.0
HTTP_JITTER_MAX=1.0
HTTP_REQUEST_TIMEOUT=60
HTTP_REQUEST_PAUSE_SECONDS=0.2

# Pausa entre operacoes de escrita no Monday (create/update/delete)
MONDAY_WRITE_PAUSE_SECONDS=1.0

# Lotes
BIMER_ENRICH_BATCH_SIZE=100

# Pipeline
TARGET_YEAR=2026
PIPELINE_TZ=America/Sao_Paulo
PIPELINE_START_DATE=2026-01-01
PIPELINE_END_DATE=2026-12-31
PIPELINE_LOG_PREFIX=[COMPRAS]
PIPELINE_SHOW_PROGRESS=true

# Dry-runs: false = executa de verdade | true = simula sem criar/apagar/atualizar
PIPELINE_CREATE_DRY_RUN=false
PIPELINE_DELETE_DUPLICATE_DRY_RUN=false
PIPELINE_DELETE_ORPHAN_DRY_RUN=false
PIPELINE_UPDATE_STATUS_DRY_RUN=false
